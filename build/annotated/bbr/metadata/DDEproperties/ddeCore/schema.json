{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DDE Mandatory metadata properties",
  "description": "Extends CDIFCore metadata with DDE-specific mandatory fields: a DDE resource type, keywords from the DDE TopicCategoryCode and AcquisitionTypeCode codelists, alternate names and browse graphics.\nThis block declares no conformance URI. In DDE the profiles under profiles/DDEProfiles are what a document instance conforms to -- each one composes this block, restricts the resource type and adds extensions -- so each profile pins its own https://w3id.org/cdif/dde/1.0/{profileName}, and a record states the profile it follows rather than the property bundle inside it. Until 2026-11-15 this block pinned https://w3id.org/cdif/bbr/metadata/DDEproperties/ddeCore through a ddeCatalogRecord wrapper, which named a register path with no version and asserted conformance to a building block that is not a document profile. schema:subjectOf is now inherited unchanged from cdifCore, which already requires it and refs cdifCatalogRecord for its shape.",
  "allOf": [
    {
      "$ref": "#/$defs/CdifCore"
    },
    {
      "$ref": "https://usgin.github.io/ddeBuildingBlocks/build/annotated/bbr/metadata/DDEproperties/ddeResourceType/schema.json"
    },
    {
      "type": "object",
      "properties": {
        "schema:keywords": {
          "type": "array",
          "description": "Extends base CDIF keyword schema to require DefinedTerms from both the DDE TopicCategoryCode and AcquisitionTypeCode codelists.",
          "minItems": 2,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/DefinedTerm"
              },
              {
                "type": "string"
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "@type": {
                    "contains": {
                      "const": "schema:DefinedTerm"
                    }
                  },
                  "schema:inDefinedTermSet": {
                    "const": "dde:codelist/TopicCategoryCode"
                  }
                },
                "required": [
                  "@type",
                  "schema:inDefinedTermSet"
                ]
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "@type": {
                    "contains": {
                      "const": "schema:DefinedTerm"
                    }
                  },
                  "schema:inDefinedTermSet": {
                    "const": "dde:codelist/AcquisitionTypeCode"
                  }
                },
                "required": [
                  "@type",
                  "schema:inDefinedTermSet"
                ]
              },
              "minContains": 1
            }
          ],
          "x-jsonld-id": "http://schema.org/keywords"
        },
        "schema:alternateName": {
          "description": "Alternative names or aliases for the resource. A list, per the CDIF convention that any 0..* or 1..* property is always an array, so a consumer never has to branch on the JSON type.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-jsonld-id": "http://schema.org/alternateName"
        },
        "schema:image": {
          "type": "array",
          "description": "Browse graphics for the resource. Optional, matching the DDE XSD, where browseGraphic is minOccurs=\"0\" maxOccurs=\"unbounded\".",
          "items": {
            "type": "object",
            "properties": {
              "@type": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "contains": {
                  "const": "schema:ImageObject"
                },
                "minItems": 1
              },
              "schema:contentUrl": {
                "type": "string",
                "format": "uri",
                "description": "URL to the image file",
                "x-jsonld-id": "http://schema.org/contentUrl"
              },
              "schema:name": {
                "type": "string",
                "description": "Caption or title for the browse graphic",
                "x-jsonld-id": "http://schema.org/name"
              },
              "schema:encodingFormat": {
                "type": "string",
                "description": "MIME type of the image",
                "x-jsonld-id": "http://schema.org/encodingFormat"
              }
            },
            "required": [
              "@type",
              "schema:contentUrl"
            ]
          },
          "x-jsonld-id": "http://schema.org/image"
        }
      },
      "required": [
        "schema:additionalType",
        "schema:keywords"
      ]
    }
  ],
  "$defs": {
    "CdifCore": {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/profiles/cdifProfile/cdifCore/schema.json"
    },
    "DefinedTerm": {
      "$ref": "https://cross-domain-interoperability-framework.github.io/metadataBuildingBlocks/build/annotated/bbr/metadata/schemaorgProperties/definedTerm/schema.json"
    }
  },
  "x-jsonld-prefixes": {
    "schema": "http://schema.org/",
    "dde": "https://www.ddeworld.org/resource/",
    "dcterms": "http://purl.org/dc/terms/"
  },
  "x-bblocks-metadata": {
    "itemIdentifier": "dde.bbr.metadata.DDEproperties.ddeCore",
    "register": "https://usgin.github.io/ddeBuildingBlocks/build/register.json",
    "version": "0.1",
    "dateOfLastChange": "2026-11-20"
  }
}