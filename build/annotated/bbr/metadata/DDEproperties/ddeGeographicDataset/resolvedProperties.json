{"defs":{},"properties":[{"path":["schema:spatialCoverage"],"id":"http://schema.org/spatialCoverage","description":"Spatial extent of the geographic dataset. Mandatory for geographicDataset resource type.","required":true,"schema_type":"array","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"effectiveId":"http://schema.org/spatialCoverage"},{"path":["schema:spatialCoverage","schema:additionalType"],"id":"http://schema.org/additionalType","description":"Domain-specific type classifications for this place (e.g. facility type,laboratory classification, feature type).","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"effectiveId":"http://schema.org/additionalType"},{"path":["schema:spatialCoverage","schema:name"],"id":"http://schema.org/name","description":"A place name for the location, either as a string or a DefinedTerm from a gazetteer.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"effectiveId":"http://schema.org/name"},{"path":["schema:spatialCoverage","schema:identifier"],"id":"http://schema.org/identifier","description":"Formal identifier for this place (e.g. ROR identifier for a facility).","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:spatialCoverage","schema:alternateName"],"id":"http://schema.org/alternateName","description":"Alternate or abbreviated name(s) for this place.","schema_type":"array","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"effectiveId":"http://schema.org/alternateName"},{"path":["schema:spatialCoverage","schema:geo"],"id":"http://schema.org/geo","description":"Either a bounding box or a point location.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"effectiveId":"http://schema.org/geo"},{"path":["schema:spatialCoverage","schema:geo","_anyOf"],"sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"keyword":"anyOf"},{"path":["schema:spatialCoverage","schema:geo","_anyOf","0"],"title":"a","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"keyword":"branch"},{"path":["schema:spatialCoverage","schema:geo","_anyOf","0","schema:latitude"],"id":"http://schema.org/latitude","required":true,"schema_type":"number","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"effectiveId":"http://schema.org/latitude"},{"path":["schema:spatialCoverage","schema:geo","_anyOf","0","schema:longitude"],"id":"http://schema.org/longitude","required":true,"schema_type":"number","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"effectiveId":"http://schema.org/longitude"},{"path":["schema:spatialCoverage","schema:geo","_anyOf","1"],"title":"b","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"keyword":"branch"},{"path":["schema:spatialCoverage","schema:geo","_anyOf","1","schema:box"],"id":"http://schema.org/box","description":"A GeoShape box defines an area on the surface of the earth defined by point locations of the southwest corner and northeast corner of the rectangle in latitude-longitude coordinates. A space should be used to separate the latitude and longitude values. The two corner coordinate points are separated by a space. 'East longitude' means positive longitude values are east of the prime (Greenwich) meridian.","required":true,"schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"effectiveId":"http://schema.org/box"},{"path":["schema:spatialCoverage","schema:geo","_anyOf","2"],"title":"c","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"keyword":"branch"},{"path":["schema:spatialCoverage","schema:geo","_anyOf","2","schema:line"],"id":"http://schema.org/line","description":"A GeoShape box defines a curvilinear geometry as a string of latitude-longitude coordinates. A space should be used to separate the latitude and longitude values. The coordinate point pairs are also separated by a space. 'East longitude' means positive longitude values are east of the prime (Greenwich) meridian. e.g. '39.33 120.77 40.44 123.96 41.00 121.34' ","required":true,"schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"],"effectiveId":"http://schema.org/line"},{"path":["schema:spatialCoverage","geosparql:hasGeometry"],"description":"Optional geographic extent using wkt geometry, see Ocean InfoHub (https://book.oceaninfohub.org/thematics/spatial/README.html#simple-geosparql-wkt). Other geometry schemes might be specified in a specific domain profile, e.g. for atmospheric, subsurface data, or local coordinate systems. NOTE that the location specified here should be the same as the schema.org point or contained within the specified bounding box.","schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"]},{"path":["schema:spatialCoverage","geosparql:hasGeometry","geosparql:asWKT"],"schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"]},{"path":["schema:spatialCoverage","geosparql:hasGeometry","geosparql:crs"],"schema_type":"object","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.spatialExtent"]},{"path":["schema:additionalProperty"],"id":"http://schema.org/additionalProperty","description":"Spatial representation properties using DDE propertyIDs. Each item is a PropertyValue with a DDE propertyID and a value whose type depends on the property.","schema_type":"array","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"effectiveId":"http://schema.org/additionalProperty"},{"path":["schema:additionalProperty","_anyOf"],"sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"keyword":"anyOf"},{"path":["schema:additionalProperty","_anyOf","0"],"title":"a","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"keyword":"branch"},{"path":["schema:additionalProperty","_anyOf","0","schema:value"],"id":"http://schema.org/value","required":true,"schema_type":"string","enum":["vector","grid","textTable","tin","stereoModel","video"],"sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"effectiveId":"http://schema.org/value"},{"path":["schema:additionalProperty","_anyOf","1"],"title":"b","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"keyword":"branch"},{"path":["schema:additionalProperty","_anyOf","1","schema:value"],"id":"http://schema.org/value","required":true,"schema_type":"string","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"effectiveId":"http://schema.org/value"},{"path":["schema:additionalProperty","_anyOf","2"],"title":"c","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"keyword":"branch"},{"path":["schema:additionalProperty","_anyOf","2","schema:value"],"id":"http://schema.org/value","required":true,"schema_type":"string","enum":["compoundEngineeringParametric","compoundEngineeringParametricTemporal","compoundEngineeringTemporal","compoundEngineeringVertical","compoundEngineeringVerticalTemporal","compoundGeographic2DParametric","compoundGeographic2DParametricTemporal","compoundGeographic2DTemporal","compoundGeographic2DVertical","compoundGeographicVerticalTemporal","compoundGeographic3DTemporal","compoundProjected2DParametric","compoundProjected2DParametricTemporal","compoundProjectedTemporal","compoundProjectedVertical","compoundProjectedVerticalTemporal","engineering","engineeringDesign","engineeringImage","geodeticGeocentric","geodeticGeographic2D","geodeticGeographic3D","geographicIdentifier","linear","parametric","projected","temporal","vertical"],"sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"effectiveId":"http://schema.org/value"},{"path":["schema:additionalProperty","_anyOf","3"],"title":"d","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"keyword":"branch"},{"path":["schema:additionalProperty","_anyOf","3","schema:value"],"id":"http://schema.org/value","description":"The reference system identifier code (e.g. \"EPSG:4326\", \"urn:ogc:def:crs:EPSG::4326\").","schema_type":"string","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"effectiveId":"http://schema.org/value"},{"path":["schema:additionalProperty","_anyOf","3","schema:url"],"id":"http://schema.org/url","description":"Resolvable URL for the reference system identifier (e.g. \"https://epsg.io/4326\").","schema_type":"string","format":"uri","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"effectiveId":"http://schema.org/url"},{"path":["schema:additionalProperty","_anyOf","4"],"title":"e","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset"],"keyword":"branch"},{"path":["schema:additionalProperty","_anyOf","4","schema:value"],"id":"http://schema.org/value","required":true,"sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/value"},{"path":["schema:additionalProperty","_anyOf","4","schema:unitCode"],"id":"http://schema.org/unitCode","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/unitCode"},{"path":["schema:additionalProperty","_anyOf","4","schema:unitText"],"id":"http://schema.org/unitText","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/unitText"},{"path":["schema:spatialCoverage","schema:additionalType","schema:termCode"],"id":"http://schema.org/termCode","description":"A representative code for this keyword in the controlled vocabulary. Analogous to skos:Notation","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/termCode"},{"path":["schema:spatialCoverage","schema:additionalType","schema:inDefinedTermSet"],"id":"http://schema.org/inDefinedTermSet","description":"The controlled vocabulary responsible for this keyword, as EITHER a plain URI string identifying the vocabulary, OR an object reference ({\"@id\": \"<uri>\"}) to a vocabulary defined elsewhere in the document. Both forms are already in use across CDIF profiles and downstream ADA building blocks; permitting only the string form made the object form - the natural JSON-LD spelling of a reference - invalid, while this class's own union-type policy above explicitly anticipates both.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/inDefinedTermSet"},{"path":["schema:spatialCoverage","schema:additionalType","schema:identifier"],"id":"http://schema.org/identifier","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/identifier"},{"path":["schema:spatialCoverage","schema:additionalType","schema:identifier","schema:propertyID"],"id":"http://schema.org/propertyID","description":"In this context for the schema:PropertyValue, this field is an identifier for the identifier schema, e.g. DOI, ARK.  Get values from https://registry.identifiers.org/registry/ for interoperability. URI-shape values MUST be serialized as JSON-LD IRI references ({\"@id\":\"...\"}) so they participate in RDF entailment; free-label strings remain valid as strings.","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:spatialCoverage","schema:additionalType","schema:identifier","schema:value"],"id":"http://schema.org/value","description":"the identifier string. E.g. 10.5066/F7VX0DMQ","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/value"},{"path":["schema:spatialCoverage","schema:additionalType","schema:identifier","schema:url"],"id":"http://schema.org/url","description":"web-resolveable string for the identifier; host name part is location of a resolver that will return some representation for the given identifier value. E.g. https://doi.org/10.5066/F7VX0DMQ ","schema_type":"string","format":"uri","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.identifier"],"effectiveId":"http://schema.org/url"},{"path":["schema:spatialCoverage","schema:additionalType","schema:name"],"id":"http://schema.org/name","description":"text label for the term that is useful to human user","schema_type":"string","sources":["bblocks://cdif.bbr.metadata.schemaorgProperties.definedTerm"],"effectiveId":"http://schema.org/name"},{"path":["schema:additionalProperty","schema:propertyID"],"id":"http://schema.org/propertyID","description":"identifier or name for the property concept quantified by the values in this variable slot. Multiple values can specify the property at different levels of granularity.","required":true,"schema_type":"array","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset","bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/propertyID"},{"path":["schema:additionalProperty","schema:name"],"id":"http://schema.org/name","required":true,"schema_type":"string","sources":["bblocks://dde.bbr.metadata.DDEproperties.ddeGeographicDataset","bblocks://cdif.bbr.metadata.schemaorgProperties.additionalProperty"],"effectiveId":"http://schema.org/name"}]}